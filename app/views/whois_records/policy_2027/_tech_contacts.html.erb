<% if contacts.any? %>
    <section class="tech-contacts">
        <h2><%= t '.header' %></h2>
        <ul class="contact-list">
            <% contacts.each do |contact| %>
                <%= render 'whois_records/policy_2027/contact', contact: contact %>
            <% end %>
        </ul>
    </section>
<% end %>
