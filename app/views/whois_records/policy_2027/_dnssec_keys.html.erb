<% if keys.present? %>
    <section class="dnssec_keys">
        <h2><%= t '.header' %></h2>
        <ul>
            <% for key in keys %>
                <li>dnskey: <%= key %></li>
            <% end %>
        </ul>

        <dl>
            <dt><%= DnssecKey.human_attribute_name :last_update %></dt>
            <dd><%= last_update %></dd>
        </dl>
    </section>
<% end %>
