{
  "extends": [
    "config:base"
  ],
  "packageRules": [
    {
      "description": "pg 1.6.0 started publishing an x86_64-linux binary built against glibc 2.29, which the deploy servers cannot load. Lift together with the server upgrade.",
      "matchPackageNames": ["pg"],
      "allowedVersions": "<1.6.0"
    },
    {
      "description": "Ruby stays where Rails 6.1 can run. Automatic bumps of .ruby-version broke this app twice: 3.3.0 (reverted in 9e9d62d) and 3.4.9, where Ruby moved bigdecimal and other libraries out of the standard library and the deploy died on the first require. Re-enable together with the Rails upgrade.",
      "matchDatasources": ["ruby-version"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": false,
      "automergeType": "pr",
      "addLabels": ["patch"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "addLabels": ["minor"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major"]
    },
    {
      "matchDepTypes": ["ruby", "bundler", "Gemfile", "Gemfile.lock"],
      "matchUpdateTypes": ["patch"],
      "addLabels": ["bundler"],
      "automerge": false,
      "automergeType": "pr"
    },
    {
      "matchDepTypes": ["ruby", "bundler", "Gemfile", "Gemfile.lock"],
      "matchUpdateTypes": ["minor", "major"],
      "addLabels": ["bundler"],
      "automerge": false
    },
    {
      "matchDepTypes": [".ruby-version"],
      "matchUpdateTypes": ["patch"],
      "addLabels": ["ruby-version"],
      "automerge": false,
      "automergeType": "pr"
    },
    {
      "matchDepTypes": [".ruby-version"],
      "matchUpdateTypes": ["minor", "major"],
      "addLabels": ["ruby-version"],
      "automerge": false
    },
    {
      "matchFileNames": [".github/workflows/ruby.yml"],
      "matchUpdateTypes": ["patch", "minor"],
      "addLabels": ["github-actions"],
      "automerge": false,
      "automergeType": "pr"
    }
  ],
  "docker": {
    "enabled": false
  },
  "ruby": {
    "stabilityDays": 60
  },
  "ignorePaths": [
    "Dockerfile", "Dockerfile.*", ".github/workflows/build_deploy_staging.yml",
    ".github/workflows/remove_st_after_pr.yml", ".github/workflows/autorebase.yml"
  ],
  "rangeStrategy": "replace",
  "separateMajorMinor": true,
  "prCreation": "immediate",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "ignoreUnstable": true,
  "dependencyDashboard": true,
  "rebaseWhen": "behind-base-branch",
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 2am"
  ]
}
